# API Configuration
BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=/api

# Django admin URL (optional, for the admin panel link)
NEXT_PUBLIC_DJANGO_ADMIN_URL=http://localhost:8000/admin

# Styleguide route (dev/QA only — leave unset in production deployments)
NEXT_PUBLIC_ENABLE_STYLEGUIDE=0

# Public origin for SEO (canonical/hreflang/sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret for /revalidate (must match backend NEXT_REVALIDATE_SECRET)
NEXT_REVALIDATE_SECRET=
# Server-only key for Django /api/catalog/pages/* (must match backend CATALOG_PAGES_SECRET)
CATALOG_PAGES_SECRET=
